# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/rlts

# JWT
JWT_SECRET=your-256-bit-random-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-different-256-bit-refresh-secret-key-change-this
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# AWS S3 (when STORAGE_TYPE=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=rlts-production
CLOUDFRONT_DOMAIN=

# Email
EMAIL_FROM=noreply@conticollect.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Firebase
FIREBASE_PROJECT_ID=conti-collect
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Google Maps
GOOGLE_MAPS_API_KEY=AIzaSyDzCAoTb1j3706Uf-3G2gI1CrJmiMJxd7s

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
